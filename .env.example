# Hula Expo app environment — placeholder names only, NO real values.
# Copy to `.env` and fill in locally. `.env` is gitignored and must never be
# committed. Only EXPO_PUBLIC_* vars are exposed to the app bundle, so never put
# a secret key here.

# Clerk publishable key (public, safe to ship in the client).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Base URL of the Hula backend (e.g. your ngrok tunnel during local dev).
# Used by the "Text hula" connect flow to call POST /v1/link-sessions.
# Restart Expo with `npx expo start -c` after changing this.
EXPO_PUBLIC_HULA_API_URL=
