{
  "name": "hula-server",
  "version": "0.1.0",
  "private": true,
  "description": "Channel-agnostic backend for the Hula AI messaging agent (Section 1 skeleton).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/normalize.test.ts && tsx scripts/linking.test.ts && tsx scripts/queries.test.ts && tsx scripts/brain.test.ts && tsx scripts/profile.test.ts && tsx scripts/messagingStatus.test.ts && tsx scripts/memory.test.ts",
    "test:persistence": "tsx --env-file-if-exists=.env scripts/persistence.manual.ts",
    "test:brain": "tsx --env-file-if-exists=.env scripts/brain.manual.ts",
    "test:memory": "tsx --env-file-if-exists=.env scripts/memory.manual.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name section8_explicit_memory"
  },
  "dependencies": {
    "@clerk/backend": "^1.34.0",
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
