// Hula server — Prisma schema (Section 4).
//
// This is the first real persistence layer. It replaces the in-memory link
// sessions and messaging identities from Section 3 and begins persisting
// provider events, conversations, and messages.
//
// Connection URLs come from the environment and are NEVER committed:
//   - DATABASE_URL: pooled Neon connection used at runtime.
//   - DIRECT_URL:   direct connection Prisma may need for migrations. If your
//                   DATABASE_URL is a pooled URL, migrations can fail against
//                   the pooler — set DIRECT_URL to Neon's direct (unpooled) URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Status of a one-time connect code.
enum LinkSessionStatus {
  pending
  used
  expired
}

/// Whether a linked messaging identity is currently usable.
enum MessagingIdentityStatus {
  active
  disabled
}

/// Direction of a stored message relative to Hula.
enum MessageDirection {
  inbound
  outbound
}

/// Kind of an explicit long-term memory (Section 8).
enum MemoryType {
  preference
  fact
  instruction
  goal
  project
  routine
  constraint
}

/// Whether a memory is currently active or has been soft-deleted (Section 8).
enum MemoryStatus {
  active
  deleted
}

/// How much a memory should weigh when personalising replies (Section 8).
enum MemoryImportance {
  low
  medium
  high
}

/// Where a reminder originated (Section 9). Only `explicit_user_request` is used
/// today — the `future_*` values reserve space for integration-sourced reminders
/// (Calendar/Zoom/Gmail/etc.) without needing a schema change later.
enum ReminderSource {
  explicit_user_request
  future_calendar
  future_integration
}

/// Lifecycle of a reminder (Section 9).
enum ReminderStatus {
  scheduled
  sent
  cancelled
  failed
}

/// A Hula account, keyed off the Clerk user id.
model User {
  id          String  @id @default(cuid())
  clerkUserId String  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile       UserProfile?
  identities    MessagingIdentity[]
  linkSessions  LinkSession[]
  conversations Conversation[]
  messages      Message[]
  memories      Memory[]
  reminders     Reminder[]

  @@map("users")
}

/// Server-side profile mirroring onboarding / settings.
model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  firstName   String?
  birthday    String?
  sex         String?
  tone        String?
  timezone    String?
  locale      String?
  country     String?
  /// Additive JSON bag for a few extra safe onboarding fields that don't need
  /// their own columns yet (Section 7): { helpMost?: string[]; discoverySource?: string }.
  preferencesJson Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// A provider sender handle (phone/email) linked to a Hula user.
model MessagingIdentity {
  id                String                  @id @default(cuid())
  userId            String
  channel           String
  provider          String
  handleNormalized  String                  @unique
  handleDisplay     String?
  status            MessagingIdentityStatus @default(active)
  linkedAt          DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("messaging_identities")
}

/// A short-lived one-time connect code for the "Text hula" flow.
model LinkSession {
  id        String            @id @default(cuid())
  code      String            @unique
  userId    String
  status    LinkSessionStatus @default(pending)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("link_sessions")
}

/// A durable thread between a user and Hula over a channel/provider.
model Conversation {
  id               String   @id @default(cuid())
  userId           String?
  channel          String
  provider         String
  externalThreadId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
  @@index([channel, provider, externalThreadId])
  @@map("conversations")
}

/// A single stored message turn (inbound or outbound).
model Message {
  id                String           @id @default(cuid())
  conversationId    String?
  userId            String?
  direction         MessageDirection
  channel           String
  provider          String
  providerMessageId String?
  senderHandle      String?
  recipientHandle   String?
  text              String?
  contentJson       Json?
  status            String?
  createdAt         DateTime         @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([userId])
  @@index([providerMessageId])
  @@map("messages")
}

/// A safe summary of an inbound/outbound provider webhook event. Raw payloads
/// are intentionally NOT stored yet — only a redacted summary.
model ProviderEvent {
  id                 String   @id @default(cuid())
  provider           String
  eventType          String
  providerEventId    String?
  providerMessageId  String?
  payloadSummaryJson Json?
  createdAt          DateTime @default(now())

  @@index([providerMessageId])
  @@map("provider_events")
}

/// An explicit, user-requested long-term memory (Section 8).
///
/// Only created when the user clearly asks Hula to remember something (source is
/// always `explicit_user_request`). Deletes are SOFT (status → deleted) so a
/// "forget" is reversible in the data and never destroys history. No automatic
/// extraction, embeddings, or raw chat is stored here — just short, sanitised
/// facts/preferences the user asked Hula to keep.
model Memory {
  id         String           @id @default(cuid())
  userId     String
  type       MemoryType       @default(fact)
  text       String
  source     String           @default("explicit_user_request")
  status     MemoryStatus     @default(active)
  confidence Float            @default(1.0)
  tags       Json?
  importance MemoryImportance @default(medium)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, type, status])
  @@map("memories")
}

/// An explicit, user-requested reminder (Section 9).
///
/// Only created when the user clearly asks Hula to remind them of something
/// ("remind me …"); `source` is always `explicit_user_request` today. There is
/// NO automatic inference from ordinary messages. A conservative local worker
/// (see `reminders/worker`) delivers due reminders proactively over iMessage via
/// Sendblue using DETERMINISTIC text — no Anthropic call is made to deliver a
/// reminder. Recurrence is limited to daily/weekly for now (`recurrenceRule` is
/// a compact "daily"/"weekly" string; `dueAt`/`nextRunAt` carry the actual
/// time-of-day and weekday). One-off reminders are marked `sent` after delivery;
/// recurring reminders advance `nextRunAt`.
model Reminder {
  id             String         @id @default(cuid())
  userId         String
  source         ReminderSource @default(explicit_user_request)
  channel        String         @default("imessage")
  provider       String         @default("sendblue")
  title          String
  body           String?
  originalText   String?
  status         ReminderStatus @default(scheduled)
  dueAt          DateTime
  timezone       String?
  recurrenceRule String?
  nextRunAt      DateTime?
  lastSentAt     DateTime?
  sendCount      Int            @default(0)
  maxSends       Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  cancelledAt    DateTime?
  failureReason  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, nextRunAt])
  @@index([status, dueAt])
  @@map("reminders")
}
