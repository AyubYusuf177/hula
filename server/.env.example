# Hula server environment (Section 1 — placeholders only)
# Copy to .env and fill in when the relevant section is implemented.
# NEVER commit a real .env. All values here are placeholder names only.

# --- Core ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Sendblue (channel provider) — placeholders, not wired yet ---
SENDBLUE_API_KEY=placeholder
SENDBLUE_API_SECRET=placeholder
SENDBLUE_HULA_NUMBER=placeholder
SENDBLUE_WEBHOOK_SIGNING_SECRET=placeholder

# --- Model / AI provider — placeholder, not wired yet ---
MODEL_PROVIDER_API_KEY=placeholder

# --- Anthropic (Hula brain) — Section 6 ---
# ANTHROPIC_API_KEY is optional: without it the brain uses a safe fallback reply.
# ANTHROPIC_MODEL is optional and defaults to claude-opus-4-8 if omitted.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Database (Postgres / Neon) — used by Prisma from Section 4 on ---
# DATABASE_URL: pooled runtime connection (Prisma client).
# DIRECT_URL:   direct (unpooled) connection for Prisma migrations. If your
#               DATABASE_URL is a Neon *pooled* URL, migrations may fail against
#               the pooler — set DIRECT_URL to Neon's direct connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Auth (Clerk) — placeholder, not wired yet ---
CLERK_SECRET_KEY=placeholder

# --- Integrations token vault (Section 10) — optional ---
# 32-byte key (base64 or hex) used to encrypt provider tokens AT REST on the
# server. Only needed once a real provider token is stored (no provider connects
# yet). Generate one with, e.g.:  openssl rand -base64 32
# Leave blank until integrations token storage is actually used.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# --- Google Calendar OAuth (Section 11) — read-only ---
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud, enable the
# Google Calendar API, and configure the OAuth consent screen. All values are
# OPTIONAL: they are only needed once a user starts the Google Calendar connect
# flow. Request READ-ONLY scopes only — never a calendar write scope.
#
# The redirect URI must EXACTLY match one registered on the OAuth client. For
# local dev over ngrok it looks like:
#   https://YOUR-NGROK-URL/v1/integrations/google_calendar/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Space-separated. Defaults to the provider catalog's read-only scope if blank.
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly

# --- Gmail OAuth (Sections 14 + 16) ---
# Gmail is a SEPARATE provider that reuses the shared Google client id/secret but
# has its OWN redirect URI. All values are OPTIONAL: only needed once a user starts
# the Gmail connect flow. The redirect URI must EXACTLY match one registered on the
# OAuth client, e.g.:
#   https://YOUR-NGROK-URL/v1/integrations/gmail/callback
GMAIL_OAUTH_REDIRECT_URI=
# Space-separated. Defaults to the catalog's least-privilege Section 16 scopes:
# gmail.readonly (read) + gmail.compose (create drafts + send). gmail.compose does
# NOT grant delete/label/modify or full-mailbox access. Never request gmail.modify
# or https://mail.google.com/. Users with a pre-Section-16 read-only grant must
# reconnect Gmail before any draft/send action can run.
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose

# --- Billing — placeholder, not wired yet ---
BILLING_PROVIDER_API_KEY=placeholder
